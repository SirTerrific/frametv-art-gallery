  "claims": [
    {
      "id": "claim_2ded0f1da12b491d81791bf240e3350c",
      "statement": "Every TV operation goes through _tv_call, which enforces the deadline from outside by running the work on a thread pool and waiting on the future with a timeout, because the samsungtvws library waits on a read without an overall timeout.",
      "evidence": [
        {
          "resource": "repo://backend/tests/test_frame_tv_timeouts.py#L1-L8",
          "version": "repo-lines-v1:sha256:1e7d4d22c11e021b9ddbfabd8f6b86dca9f6365e8aa93ee8b88c58f44d746946:"
        },
        {
          "resource": "repo://backend/utils/tv_connection.py#L383-L493",
          "version": "repo-lines-v1:sha256:6f9fc2816dd9c73230b525a746976f7c3a35ee7d70253ff32aa6b0506683358a:"
        }
      ]
    },
    {
      "id": "claim_760f3aba66034b12aba85fd52a38740a",
      "statement": "frame_tv.py re-exports the exception classes, session class and helpers from tv_connection and defines a thin _tv_call that supplies the session factory and busy wait then delegates, so the session factory stays patchable in one place.",
      "evidence": [
        {
          "resource": "repo://backend/utils/frame_tv.py#L939-L965",
          "version": "repo-lines-v1:sha256:0e1bacefd6a67b0e75532ecc87522439ce0839a4f07c7373a0d834a9a7862066:"
        }
      ]
    },
    {
      "id": "claim_16a55f814342465b8f2c88b925269dc4",
      "statement": "Only one call talks to a given TV at a time: a per-IP thread lock is backed, where fcntl exists, by a per-TV lock file taken with non-blocking flock so it holds across gunicorn worker processes, and a call that cannot get the lock within its wait raises FrameTVUnavailableError.",
      "evidence": [
        {
          "resource": "repo://backend/utils/tv_connection.py#L216-L265",
          "version": "repo-lines-v1:sha256:0c226e5a2ed6e4c48eb0594d532eadf1e80a5e1850209b2f04fff351fbf612c5:"
        }
      ]
    },
    {
      "id": "claim_4694b9092a1a49ea82ed10a2f3be16ad",
      "statement": "A background call waits for the TV lock only as long as its own deadline, while a deliberate action (skip_when_down false) waits up to the busy wait, 90 seconds by default, so it can queue behind a long read.",
      "evidence": [
        {
          "resource": "repo://backend/utils/tv_connection.py#L395-L395",
          "version": "repo-lines-v1:sha256:66c9d74e4f58dc941e9f6cb0dd75179e554982db88733cb0a2aa9b6422cc72af:"
        }
      ]
    },
    {
