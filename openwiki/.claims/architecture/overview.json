    {
      "id": "claim_1d06cb16b0354570abd3f2a4a951fc0f",
      "statement": "CORS is off by default; it is enabled only for origins listed in the CORS_ORIGINS environment variable, and an after_request hook always sets X-Content-Type-Options nosniff, X-Frame-Options DENY and a strict-origin-when-cross-origin referrer policy.",
      "evidence": [
