    {
      "id": "claim_ce88836a1f524c7fb727dc918d7df78a",
      "statement": "init_db runs at module import, always calls db.create_all, and stamps alembic at head only when the database file did not exist beforehand; an existing database is left to migrate normally.",
      "evidence": [
        {
          "resource": "repo://backend/app.py#L133-L147",
          "version": "repo-lines-v1:sha256:25a7936d5ed3f2dcd1a98d0c94a28350265055845658043e529cabb2673a6086:"
        }
      ]
    },
    {
      "id": "claim_b235b50df3654227a12dd22200a7a9f5",
      "statement": "The container entrypoint runs flask db upgrade before starting the server and exits with status 1, printing an explanation, if the upgrade fails, so the app does not start against a schema it could not migrate.",
      "evidence": [
        {
          "resource": "repo://backend/entrypoint.sh#L4-L31",
          "version": "repo-lines-v1:sha256:d6b2573914e45cbde4ef46921510a953ca61075bac607abb0031ec50eb5b0f6e:"
        }
      ]
    },
    {
      "id": "claim_7c2ffde7b038466eb1399bf8822236a1",
      "statement": "Going back to an older image does not roll the schema back: an older image lacks the newer database revision, so the upgrade fails with Can't locate revision, and the entrypoint explains the two recoveries (run the newer image, or rewind alembic_version by hand).",
      "evidence": [
        {
          "resource": "repo://backend/entrypoint.sh#L12-L27",
          "version": "repo-lines-v1:sha256:049c0615d88416a67d40ae309bb5ea540fe41aca0b43119a1868344dd576392c:"
        }
      ]
    },
    {
