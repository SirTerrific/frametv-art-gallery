  "claims": [
    {
      "id": "claim_091d99b3d34346868c72b0273b6a331f",
      "statement": "The Dockerfile must be built from the repository root because the app serves the frontend build from one level above itself and pyproject reads the README at the root, neither being reachable from a build context narrowed to backend/.",
      "evidence": [
        {
          "resource": "repo://backend/Dockerfile#L1-L3",
          "version": "repo-lines-v1:sha256:f382ccc248f2a7c5132bf0b201806eed90f04f88280797c2896ecab8b52fcf15:"
        }
      ]
    },
    {
      "id": "claim_0d0613979a37440fb7555fe5228d099e",
      "statement": "The runtime image copies the backend code and a prebuilt frontend/build directory to /frontend/build, so the frontend is built by the workflow before the image, not inside the Dockerfile.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/build_image.yaml#L61-L61",
          "version": "repo-lines-v1:sha256:504b044abdaed9cfba71ae36b7e284692dd1ef1701ddd3db08ce09433388f7d4:"
